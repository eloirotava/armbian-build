# MXQ TV box based on Amlogic S805 quad core 1GB RAM SoC GBE
BOARD_NAME="MXQ"
BOARD_VENDOR="amlogic"
BOARDFAMILY="meson8b"
BOARD_MAINTAINER=""
INTRODUCED="2015"
KERNEL_TARGET="current,edge"
KERNEL_TEST_TARGET="current,edge"
BOOTCONFIG="none"
BOOTSCRIPT="boot-aml-s805-mxq.cmd:boot.cmd"
# The preinstalled U-BOOT looks for this script
BOOTSCRIPT_OUTPUT="s805_autoscript"
BOOTENV_FILE="aml-s805-mxq.txt"

BOOTSIZE="200"
BOOTFS_TYPE="fat"

# The factory U-Boot only fatloads its boot files from a partition typed
# FAT16 (0x0e) and marked bootable; Armbian types /boot as XBOOTLDR (0xea).
function post_create_partitions__mxq_fat16_boot() {
	display_alert "Boot partition as FAT16 LBA, bootable" "${SDCARD}.raw" "info"
	run_host_command_logged sfdisk --part-type "${SDCARD}".raw 1 0e
	run_host_command_logged sfdisk --activate "${SDCARD}".raw 1
}

# The factory U-Boot on these boxes fatloads boot.scr (then kernel.img) from
# the first partition of the SD card, not s805_autoscript; others look for
# aml_autoscript.  Ship the compiled boot script under all three names.
function pre_umount_final_image__mxq_boot_scr_names() {
	display_alert "Boot script also as boot.scr and aml_autoscript" "${BOARD}" "info"
	run_host_command_logged cp -v "${MOUNT}/boot/s805_autoscript" "${MOUNT}/boot/boot.scr"
	run_host_command_logged cp -v "${MOUNT}/boot/s805_autoscript" "${MOUNT}/boot/aml_autoscript"
}

# Out-of-tree modules, built against the kernel of this very build (same
# tree, same compiler) and shipped in the kernel package, in extra/:
#   amlnf    the vendor NAND stack; the NAND boot keeps its root on /dev/data
#   ssv6xxx  SSV6051/SSV6256 SDIO Wi-Fi (firmware goes in with the rootfs)
# A module that does not build only leaves a warning, so the image still
# comes out; check the build log for "mxq module".
declare -g MXQ_AMLNF_COMMIT="5368c92134b548fb170ce0d7c2817a7b0a5b2e2e"
declare -g MXQ_SSV6XXX_COMMIT="d9f2ee435bb313c98fe6e867e612129f721dc7df"
function pre_package_kernel_image__mxq_extra_modules() {
	declare extra="${tmp_kernel_install_dirs[INSTALL_MOD_PATH]}/lib/modules/${kernel_version_family}/extra"
	declare name commit src ko
	run_host_command_logged mkdir -p "${extra}"
	for name in amlnf ssv6xxx; do
		commit="MXQ_${name^^}_COMMIT"
		commit="${!commit}"
		src="${SRC}/cache/sources/mxq-${name}"
		rm -rf "${src}"
		if git clone --quiet "https://github.com/eloirotava/${name}.git" "${src}" &&
			git -C "${src}" checkout --quiet "${commit}" &&
			run_kernel_make -C "${kernel_work_dir}" M="${src}" CONFIG_SSV6XXX=m modules &&
			compgen -G "${src}/*.ko" > /dev/null; then
			for ko in "${src}"/*.ko; do
				"${KERNEL_COMPILER}strip" --strip-debug "${ko}" || true
				install -m 0644 "${ko}" "${extra}/"
			done
			display_alert "mxq module built" "${name} @ ${commit:0:7}: $(cd "${src}" && ls ./*.ko)" "info"
		else
			display_alert "mxq module FAILED to build" "${name} @ ${commit:0:7}" "wrn"
		fi
	done
	# modules_install ran depmod before extra/ was filled
	run_host_command_logged depmod -b "${tmp_kernel_install_dirs[INSTALL_MOD_PATH]}" "${kernel_version_family}"
}

# The NAND installer (grava-do-sd) and the SSV firmware, in the rootfs.
function post_family_tweaks__mxq_nand_kit_and_firmware() {
	declare kit="${SRC}/packages/bsp/aml-s805-mxq"
	run_host_command_logged install -D -m 0755 "${kit}/nand/grava-do-sd" "${SDCARD}/usr/local/sbin/grava-do-sd"
	run_host_command_logged install -D -m 0755 "${kit}/nand/pack-bootimg.py" "${SDCARD}/usr/local/lib/mxq-nand/pack-bootimg.py"
	run_host_command_logged install -D -m 0644 "${kit}/nand/initrd-mini-base.img" "${SDCARD}/usr/local/lib/mxq-nand/initrd-mini-base.img"
	run_host_command_logged install -D -m 0644 -t "${SDCARD}/lib/firmware/ssv" "${kit}/firmware/ssv/ssv6051-sw.bin" "${kit}/firmware/ssv/ssv6x5x-sw.bin"
	# amlnf binds to the NAND node of the -nand dtbs. Loaded on its own it
	# would come up readonly=1, and the vendor FTL cannot open an already
	# written partition read-only: it takes the refused writes for failing
	# blocks and brings the box down. grava-do-sd loads it by name, with
	# readonly=0, which a blacklist does not prevent.
	echo "blacklist amlnf" > "${SDCARD}/etc/modprobe.d/amlnf.conf"
	# meson-mx-sdio is a module on edge (to be able to work on it in place);
	# when booting from the SD card the root sits behind it, so the initrd
	# must carry it.
	grep -qx meson-mx-sdio "${SDCARD}/etc/initramfs-tools/modules" 2> /dev/null ||
		echo meson-mx-sdio >> "${SDCARD}/etc/initramfs-tools/modules"
}

# Booting from the SD card, use the NAND dtb on edge: it keeps the card slot
# and adds the NAND controller, so grava-do-sd can reach the NAND.
function pre_umount_final_image__mxq_sd_boots_nand_dtb() {
	[[ "${BRANCH}" == "edge" ]] || return 0
	# plain sed: run_host_command_logged joins its arguments into a shell line,
	# and the "|" of the expression would become a pipe
	sed -i "s|^dtb_file=.*|dtb_file=/dtb/meson8b-mxq-nand.dtb|" "${MOUNT}/boot/armbianEnv.txt"
	display_alert "SD boots with" "$(grep dtb_file "${MOUNT}/boot/armbianEnv.txt")" "info"
}
