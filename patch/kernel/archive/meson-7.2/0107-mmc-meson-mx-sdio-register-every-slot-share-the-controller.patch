-				"failed to set MMC clock to %lu: %d\n",
-				clk_rate, host->error);
-		return;
+	/* rate = parent / (div + 1), never faster than asked */
+	if (ios->clock)
+		div = DIV_ROUND_UP(ctrl->div_parent_rate, ios->clock) - 1;
+	else
+		div = GENMASK(9, 0);
+	div = min_t(u32, div, GENMASK(9, 0));
+	conf |= div;
+	mmc->actual_clock = ios->clock ? ctrl->div_parent_rate / (div + 1) : 0;
+
+	spin_lock_irqsave(&ctrl->lock, flags);
+	slot->conf = conf;
+	/* an idle controller follows the last slot that changed its bus */
+	if (!ctrl->active) {
+		if (ctrl->port != slot->id) {
+			meson_mx_mmc_soft_reset(ctrl);
+			ctrl->port = slot->id;
+			regmap_write_bits(ctrl->regmap, MESON_MX_SDIO_MULT,
+					  MESON_MX_SDIO_MULT_PORT_SEL_MASK,
+					  slot->id);
+		}
+		regmap_update_bits(ctrl->regmap, MESON_MX_SDIO_CONF,
+				   MESON_MX_SDIO_CONF_SLOT_MASK, conf);
 	}
+	spin_unlock_irqrestore(&ctrl->lock, flags);
 
-	mmc->actual_clock = clk_get_rate(host->cfg_div_clk);
-
+	slot->error = 0;
 	switch (ios->power_mode) {
 	case MMC_POWER_OFF:
 		vdd = 0;
 		fallthrough;
 	case MMC_POWER_UP:
-		if (!IS_ERR(mmc->supply.vmmc)) {
-			host->error = mmc_regulator_set_ocr(mmc,
+		if (!IS_ERR(mmc->supply.vmmc))
+			slot->error = mmc_regulator_set_ocr(mmc,
 							    mmc->supply.vmmc,
 							    vdd);
-			if (host->error)
-				return;
-		}
 		break;
 	}
 }
