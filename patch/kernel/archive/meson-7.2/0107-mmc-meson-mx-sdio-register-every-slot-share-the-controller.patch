-	spin_lock_irqsave(&host->irq_lock, irqflags);
+	spin_lock_irqsave(&ctrl->lock, flags);
+	cmd = slot->cmd;
+	if (ctrl->active != slot || !cmd) {
+		spin_unlock_irqrestore(&ctrl->lock, flags);
+		return;
