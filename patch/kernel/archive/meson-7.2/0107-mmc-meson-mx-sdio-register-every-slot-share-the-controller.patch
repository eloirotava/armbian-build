+/* One slot: a card on one of the controller ports. */
+struct meson_mx_mmc_slot {
+	struct meson_mx_mmc_ctrl	*ctrl;
 	struct mmc_host			*mmc;
+	unsigned int			id;		/* port number, DT "reg" */
 
-	struct mmc_request		*mrq;
-	struct mmc_command		*cmd;
+	/* clock divider and bus width, applied whenever the slot runs */
