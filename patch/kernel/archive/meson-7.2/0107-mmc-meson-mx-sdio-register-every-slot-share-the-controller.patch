-static void meson_mx_mmc_request_done(struct meson_mx_mmc_host *host)
+/*
+ * Give the controller to @slot and start its request.  Switching ports
+ * resets the controller first, as the vendor driver does before every
+ * command, and loads the slot's clock divider and bus width.
+ * Called with ctrl->lock held.
+ */
+static void meson_mx_mmc_run(struct meson_mx_mmc_slot *slot)
 {
-	struct mmc_request *mrq;
+	struct meson_mx_mmc_ctrl *ctrl = slot->ctrl;
+	struct mmc_request *mrq = slot->mrq;
 
-	mrq = host->mrq;
+	ctrl->active = slot;
+	slot->waiting = false;
 
-	if (host->cmd->error)
-		meson_mx_mmc_soft_reset(host);
+	if (ctrl->port != slot->id) {
+		meson_mx_mmc_soft_reset(ctrl);
+		ctrl->port = slot->id;
+	}
+	regmap_update_bits(ctrl->regmap, MESON_MX_SDIO_CONF,
+			   MESON_MX_SDIO_CONF_SLOT_MASK, slot->conf);
 
-	host->mrq = NULL;
-	host->cmd = NULL;
+	if (mrq->data)
+		regmap_write(ctrl->regmap, MESON_MX_SDIO_ADDR,
+			     sg_dma_address(mrq->data->sg));
 
-	mmc_request_done(host->mmc, mrq);
+	meson_mx_mmc_start_cmd(slot, mrq->sbc ?: mrq->cmd);
+}
+
+/*
+ * The running request of @slot is over: release the controller, hand it
+ * to the next slot that is waiting, and return the request so the caller
+ * can complete it once the lock is dropped.
+ * Called with ctrl->lock held.
+ */
+static struct mmc_request *meson_mx_mmc_finish(struct meson_mx_mmc_slot *slot)
+{
+	struct meson_mx_mmc_ctrl *ctrl = slot->ctrl;
+	struct mmc_request *mrq = slot->mrq;
+	unsigned int i;
+
+	if (slot->cmd && slot->cmd->error)
+		meson_mx_mmc_soft_reset(ctrl);
+
+	slot->mrq = NULL;
+	slot->cmd = NULL;
+	ctrl->active = NULL;
+	ctrl->irq_cmd = NULL;
+
+	for (i = 0; i < MESON_MX_SDIO_MAX_SLOTS; i++) {
+		unsigned int n = (ctrl->next_slot + i) % MESON_MX_SDIO_MAX_SLOTS;
+		struct meson_mx_mmc_slot *next = ctrl->slots[n];
+
+		if (next && next->waiting) {
+			ctrl->next_slot = n + 1;
+			meson_mx_mmc_run(next);
+			break;
+		}
+	}
+
+	return mrq;
+}
+
+static void meson_mx_mmc_unmap(struct meson_mx_mmc_slot *slot,
+			       struct mmc_data *data)
+{
+	dma_unmap_sg(mmc_dev(slot->mmc), data->sg, data->sg_len,
+		     mmc_get_dma_dir(data));
 }
 
