From: Armbian MXQ edge port <nobody@localhost>
Subject: meson8b: port Ethernet RMII clock tree and mpeg_rtc_osc_sel for 7.2

Refreshed from Martin Blumenstingl's meson-mx series (as carried in
domin144 meson-6.16) for linux-7.2.y:
- HHI_* macros live in meson8b.c (meson8b.h removed upstream)
- meson8b_clk_regmaps[] removed; clk_regmap_init resolves the map
- clk81 symbols renamed to meson8b_clk81_*

diff --git a/drivers/clk/meson/Kconfig b/drivers/clk/meson/Kconfig
index cf8cf3f9e..95982af5a 100644
--- a/drivers/clk/meson/Kconfig
+++ b/drivers/clk/meson/Kconfig
@@ -57,6 +57,7 @@ config COMMON_CLK_MESON8B
 	select COMMON_CLK_MESON_REGMAP
 	select COMMON_CLK_MESON_CLKC_UTILS
 	select COMMON_CLK_MESON_MPLL
+	select COMMON_CLK_MESON_PHASE
 	select COMMON_CLK_MESON_PLL
 	select MFD_SYSCON
 	select RESET_CONTROLLER
